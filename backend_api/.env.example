# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (CORS origin)
CLIENT_URL=http://localhost:3000

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/mydb?schema=public"
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/mydb_test?schema=public"

# Security & Session Secrets
JWT_SECRET=placeholder_jwt_secret_change_in_production
COOKIE_SECRET=placeholder_cookie_secret_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_NAME=lo_auth_token

# Reverse Proxy (Set to 1, true, false, or subnet/IPs)
TRUST_PROXY=1
