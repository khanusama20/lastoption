generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. Users & Address Book
// -----------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  phone        String?   @db.VarChar(20)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String?   @map("first_name") @db.VarChar(100)
  lastName     String?   @map("last_name") @db.VarChar(100)
  role         String    @default("customer") @db.VarChar(20) // 'customer' or 'admin'
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  addresses    Address[]
  orders       Order[]
  cart         Cart?

  @@map("users")
}

model Address {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  fullName     String    @map("full_name") @db.VarChar(200)
  phone        String    @db.VarChar(20)
  addressLine1 String    @map("address_line1") @db.VarChar(255)
  addressLine2 String?   @map("address_line2") @db.VarChar(255)
  landmark     String?   @db.VarChar(150)
  city         String    @db.VarChar(100)
  state        String    @db.VarChar(100)
  pincode      String    @db.VarChar(10)
  isDefault    Boolean   @default(false) @map("is_default")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// -----------------------------------------------------------------------------
// 2. Product Catalog, Gallery & Inventory
// -----------------------------------------------------------------------------

model Product {
  id               String           @id @default(uuid()) @db.Uuid
  title            String           @db.VarChar(255)
  slug             String           @unique @db.VarChar(255)
  category         String           @db.VarChar(50) // 'bomber', 'field', 'parka', 'overcoat'
  tag              String           @db.VarChar(100) // e.g. "Water-resistant Twill"
  description      String           @db.Text
  materialsAndCare String?          @map("materials_and_care") @db.Text
  basePrice        Int              @map("base_price") // Stored in paise (e.g. 499900 = ₹4,999)
  compareAtPrice   Int?             @map("compare_at_price") // Stored in paise
  isPublished      Boolean          @default(false) @map("is_published")
  rating           Decimal?         @db.Decimal(2, 1) // null when unrated; truthful state
  reviewCount      Int              @default(0) @map("review_count") // initial truthful state: 0 reviews
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  images           ProductImage[]
  variants         ProductVariant[]

  @@index([category])
  @@index([isPublished])
  @@map("products")
}

model ProductImage {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  imageUrl     String   @map("image_url") @db.Text
  altText      String?  @map("alt_text") @db.VarChar(255)
  displayOrder Int      @default(0) @map("display_order")
  isPrimary    Boolean  @default(false) @map("is_primary")

  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id            String       @id @default(uuid()) @db.Uuid
  productId     String       @map("product_id") @db.Uuid
  sku           String       @unique @db.VarChar(100) // e.g. "LO-JKT-BOMB-BLK-M"
  size          String       @db.VarChar(20) // 'S', 'M', 'L', 'XL', 'XXL'
  colorName     String       @map("color_name") @db.VarChar(50)
  colorHex      String       @map("color_hex") @db.VarChar(10)
  priceOverride Int?         @map("price_override") // in paise, null if basePrice applies
  stockQuantity Int          @default(0) @map("stock_quantity")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([productId])
  @@index([size])
  @@map("product_variants")
}

// -----------------------------------------------------------------------------
// 3. Shopping Cart (Cross-Session Persistence)
// -----------------------------------------------------------------------------

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String?    @unique @map("user_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  quantity  Int            @default(1)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// -----------------------------------------------------------------------------
// 4. Orders, Line Items & Fulfillment
// -----------------------------------------------------------------------------

model Order {
  id                     String             @id @default(uuid()) @db.Uuid
  orderNumber            String             @unique @map("order_number") @db.VarChar(50)
  trackingToken          String             @unique @map("tracking_token") @db.VarChar(64)
  userId                 String?            @map("user_id") @db.Uuid
  customerEmail          String             @map("customer_email") @db.VarChar(255)
  customerPhone          String             @map("customer_phone") @db.VarChar(20)
  status                 String             @default("PLACED") @db.VarChar(30)
  paymentMethod          String             @map("payment_method") @db.VarChar(30) // 'ONLINE_RAZORPAY' or 'CASH_ON_DELIVERY'
  paymentStatus          String             @default("PENDING") @map("payment_status") @db.VarChar(30)
  subtotal               Int                // in paise
  shippingFee            Int                @default(0) @map("shipping_fee") // in paise
  totalAmount            Int                @map("total_amount") // in paise
  shippingAddressSnapshot Json              @map("shipping_address_snapshot") @db.JsonB
  courierName            String?            @map("courier_name") @db.VarChar(100)
  courierAwb             String?            @map("courier_awb") @db.VarChar(100)
  courierTrackingUrl     String?            @map("courier_tracking_url") @db.Text
  notes                  String?            @db.Text
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                   User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  items                  OrderItem[]
  payments               Payment[]
  otpVerifications       OtpVerification[]

  @@index([userId])
  @@index([status])
  @@index([customerEmail])
  @@map("orders")
}

model OrderItem {
  id           String          @id @default(uuid()) @db.Uuid
  orderId      String          @map("order_id") @db.Uuid
  variantId    String?         @map("variant_id") @db.Uuid
  productTitle String          @map("product_title") @db.VarChar(255)
  variantSku   String          @map("variant_sku") @db.VarChar(100)
  size         String          @db.VarChar(20)
  colorName    String          @map("color_name") @db.VarChar(50)
  unitPrice    Int             @map("unit_price") // in paise
  quantity     Int
  totalPrice   Int             @map("total_price") // in paise
  thumbnailUrl String?         @map("thumbnail_url") @db.Text

  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// -----------------------------------------------------------------------------
// 5. Payment Audit & COD Fraud Prevention
// -----------------------------------------------------------------------------

model Payment {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  provider          String   @db.VarChar(50) // 'RAZORPAY', 'COD'
  providerOrderId   String?  @map("provider_order_id") @db.VarChar(100)
  providerPaymentId String?  @map("provider_payment_id") @db.VarChar(100)
  providerSignature String?  @map("provider_signature") @db.VarChar(255)
  amount            Int      // in paise
  currency          String   @default("INR") @db.VarChar(10)
  status            String   @db.VarChar(30) // 'INITIATED', 'SUCCESS', 'FAILED'
  rawPayload        Json?    @map("raw_payload") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model OtpVerification {
  id          String   @id @default(uuid()) @db.Uuid
  phone       String   @db.VarChar(20)
  otpCodeHash String   @map("otp_code_hash") @db.VarChar(255)
  purpose     String   @default("COD_CONFIRMATION") @db.VarChar(50)
  orderId     String?  @map("order_id") @db.Uuid
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  isUsed      Boolean  @default(false) @map("is_used")
  attempts    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order       Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@map("otp_verifications")
}
